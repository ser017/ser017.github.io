<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ title or "Мой сайт статей" }}</title>
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">

</head>
<body>
  <div class="container">
    <header class="header">
      <div class="site-title"><a href="/" style="color:inherit;text-decoration:none">{{ site.title or "блог" }}</a></div>
      <nav class="nav">
        <a href="{{ baseUrl }}/me/">About</a> &nbsp; · &nbsp;
        <a href="/tags/">Tags</a>
      </nav>
    </header>

    {% block content %}{{ content | safe }}{% endblock %}


    <footer style="margin-top:40px;color:var(--muted);font-size:13px">
      ser017 © {{ "" | yearNow }}
    </footer>

  </div>
</body>
</html>
